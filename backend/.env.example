# --- Backend environment (copy to .env and fill in) ---

# Google Gemini API key. Get one at https://aistudio.google.com/apikey
# NEVER commit the real value. Server-side only — the mobile app never sees it.
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model used for the styling note.
GEMINI_MODEL=gemini-3.6-flash

# Port the backend listens on.
PORT=4000

# Absolute base URL the mobile client uses to reach this server. It is prefixed
# onto the returned resultImageUrl so the app can load the bundled mock image.
#   iOS simulator:      http://localhost:4000
#   Android emulator:   http://10.0.2.2:4000
#   Physical device:    http://<your-machine-LAN-IP>:4000
PUBLIC_BASE_URL=http://localhost:4000
